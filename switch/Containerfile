FROM localhost/pacman-packages-switch-audio-test:latest

ENV DEVKITPRO=/opt/devkitpro \
    DEVKITARM=/opt/devkitpro/devkitA64 \
    PATH=/opt/devkitpro/devkitA64/bin:/opt/devkitpro/tools/bin:/opt/devkitpro/portlibs/switch/bin:${PATH}

WORKDIR /work

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      autoconf \
      automake \
      autoconf-archive \
      libtool \
      make \
      pkg-config \
 && rm -rf /var/lib/apt/lists/*

# Fail early if the expected Switch toolchain pieces are missing.
RUN test -x /opt/devkitpro/devkitA64/bin/aarch64-none-elf-g++ \
 && test -f /opt/devkitpro/libnx/switch_rules \
 && dkp-pacman -Q switch-sdl2 >/dev/null \
 && dkp-pacman -Q switch-sdl2_ttf >/dev/null \
 && dkp-pacman -Q switch-sdl2_image >/dev/null \
 && dkp-pacman -Q switch-openal-soft >/dev/null \
 && dkp-pacman -Q switch-mesa >/dev/null \
 && dkp-pacman -Q switch-glad >/dev/null \
 && dkp-pacman -Q switch-glm >/dev/null
